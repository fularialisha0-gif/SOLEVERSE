{
  "entities": {
    "User": {
      "title": "User",
      "description": "Customer account profile and default shipping details",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "phone": { "type": "string", "maxLength": 24 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "role": { "type": "string", "enum": ["customer"] },
        "defaultAddress": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "email", "role", "createdAt", "updatedAt"]
    },
    "Category": {
      "title": "Category",
      "description": "Footwear collection category",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 60 },
        "slug": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9\\-]+$" },
        "description": { "type": "string", "maxLength": 300 },
        "sortOrder": { "type": "number" },
        "active": { "type": "boolean" }
      },
      "required": ["id", "name", "slug", "sortOrder", "active"]
    },
    "Product": {
      "title": "Product",
      "description": "Footwear SKU with INR pricing, discounts, sizes, colors, and inventory",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 2, "maxLength": 120 },
        "slug": { "type": "string", "minLength": 2, "maxLength": 120 },
        "category": { "type": "string", "minLength": 2, "maxLength": 60 },
        "categories": { "type": "array" },
        "priceInr": { "type": "number" },
        "discountPercent": { "type": "number" },
        "sizes": { "type": "array" },
        "colors": { "type": "array" },
        "images": { "type": "array" },
        "description": { "type": "string", "minLength": 5, "maxLength": 2000 },
        "specs": { "type": "object" },
        "stock": { "type": "number" },
        "rating": { "type": "number" },
        "reviewCount": { "type": "number" },
        "featured": { "type": "boolean" },
        "has3DPreview": { "type": "boolean" },
        "shoePalette": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "slug", "category", "categories", "priceInr", "discountPercent", "sizes", "colors", "images", "description", "stock", "rating", "featured", "createdAt", "updatedAt"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order record with INR totals, delivery address, payment method, and status",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "customerName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "customerEmail": { "type": "string", "format": "email", "maxLength": 160 },
        "customerPhone": { "type": "string", "minLength": 7, "maxLength": 24 },
        "deliveryAddress": { "type": "object" },
        "items": { "type": "array" },
        "subtotalInr": { "type": "number" },
        "discountInr": { "type": "number" },
        "shippingInr": { "type": "number" },
        "totalInr": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["COD", "RAZORPAY"] },
        "paymentStatus": { "type": "string", "enum": ["PENDING", "PAID", "COD_DUE", "FAILED"] },
        "razorpayOrderId": { "type": "string", "maxLength": 128 },
        "razorpayPaymentId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["PLACED", "CONFIRMED", "SHIPPED", "DELIVERED", "CANCELLED"] },
        "trackingCode": { "type": "string", "maxLength": 64 },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "customerName", "customerEmail", "customerPhone", "deliveryAddress", "items", "subtotalInr", "discountInr", "shippingInr", "totalInr", "paymentMethod", "paymentStatus", "status", "createdAt", "updatedAt"]
    },
    "Cart": {
      "title": "Cart",
      "description": "Persisted shopping cart per authenticated user",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "items": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "items", "updatedAt"]
    },
    "Wishlist": {
      "title": "Wishlist",
      "description": "Persisted wishlist product IDs per authenticated user",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "productIds": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "productIds", "updatedAt"]
    },
    "StoreSettings": {
      "title": "StoreSettings",
      "description": "Public white-label storefront configuration editable by admin",
      "type": "object",
      "properties": {
        "brandName": { "type": "string", "minLength": 1, "maxLength": 60 },
        "tagline": { "type": "string", "minLength": 1, "maxLength": 120 },
        "accentColor": { "type": "string", "minLength": 4, "maxLength": 20 },
        "contactEmail": { "type": "string", "format": "email", "maxLength": 160 },
        "contactPhone": { "type": "string", "maxLength": 24 },
        "whatsappNumber": { "type": "string", "maxLength": 24 },
        "heroTitle": { "type": "string", "maxLength": 140 },
        "heroSubtitle": { "type": "string", "maxLength": 300 },
        "freeShippingThresholdInr": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["brandName", "tagline", "accentColor", "contactEmail", "whatsappNumber", "freeShippingThresholdInr", "updatedAt"]
    },
    "ContactMessage": {
      "title": "ContactMessage",
      "description": "Customer support contact form submission",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "subject": { "type": "string", "minLength": 2, "maxLength": 140 },
        "message": { "type": "string", "minLength": 5, "maxLength": 2000 },
        "userId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "email", "subject", "message", "createdAt"]
    },
    "NewsletterSubscriber": {
      "title": "NewsletterSubscriber",
      "description": "Newsletter subscription email record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email", "createdAt"]
    },
    "AdminMember": {
      "title": "AdminMember",
      "description": "Authorized store administrator registry",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "role": { "type": "string", "enum": ["admin"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Customer profile documents strictly isolated to owner and admins"
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Publicly readable footwear categories managed by admins"
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Publicly readable footwear catalog managed by admins"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer orders isolated per userId and fully managed by admins"
    },
    "/carts/{userId}": {
      "schema": { "$ref": "#/entities/Cart" },
      "description": "Shopping cart state persisted per user"
    },
    "/wishlists/{userId}": {
      "schema": { "$ref": "#/entities/Wishlist" },
      "description": "Saved wishlist items persisted per user"
    },
    "/storeSettings/{settingId}": {
      "schema": { "$ref": "#/entities/StoreSettings" },
      "description": "Configurable white-label storefront settings"
    },
    "/contactMessages/{messageId}": {
      "schema": { "$ref": "#/entities/ContactMessage" },
      "description": "Customer support inquiries readable only by admins"
    },
    "/newsletterSubscribers/{subscriberId}": {
      "schema": { "$ref": "#/entities/NewsletterSubscriber" },
      "description": "Newsletter subscription records readable only by admins"
    },
    "/admins/{uid}": {
      "schema": { "$ref": "#/entities/AdminMember" },
      "description": "Store administrator authorization registry"
    }
  }
}
