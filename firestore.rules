rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: default-deny all unspecified paths
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Reusable Primitives ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdminEmail() {
      return isVerified() && request.auth.token.email == 'fularialisha0@gmail.com';
    }

    function isAdmin() {
      return isAdminEmail() || (isVerified() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // --- Validation Blueprints ---
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'role', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'phone', 'photoURL', 'role', 'defaultAddress', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.role == 'customer'
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 24))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && (!('defaultAddress' in data) || data.defaultAddress is map)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['id', 'name', 'slug', 'sortOrder', 'active'])
        && data.keys().hasOnly(['id', 'name', 'slug', 'description', 'sortOrder', 'active'])
        && isValidId(data.id)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 60
        && data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 64
        && (!('description' in data) || (data.description is string && data.description.size() <= 300))
        && data.sortOrder is number
        && data.active is bool;
    }

    function isValidProduct(data) {
      return data.keys().hasAll([
          'id', 'name', 'slug', 'category', 'categories', 'priceInr',
          'discountPercent', 'sizes', 'colors', 'images', 'description',
          'stock', 'rating', 'featured', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'name', 'slug', 'category', 'categories', 'priceInr',
          'discountPercent', 'sizes', 'colors', 'images', 'description',
          'specs', 'stock', 'rating', 'reviewCount', 'featured',
          'has3DPreview', 'shoePalette', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 120
        && data.slug is string && data.slug.size() >= 2 && data.slug.size() <= 120
        && data.category is string && data.category.size() >= 2 && data.category.size() <= 60
        && data.categories is list && data.categories.size() >= 1 && data.categories.size() <= 7 && data.categories[0] is string
        && data.priceInr is number && data.priceInr > 0 && data.priceInr <= 10000000
        && data.discountPercent is number && data.discountPercent >= 0 && data.discountPercent <= 90
        && data.sizes is list && data.sizes.size() >= 1 && data.sizes.size() <= 15
        && data.colors is list && data.colors.size() >= 1 && data.colors.size() <= 10
        && data.images is list && data.images.size() >= 1 && data.images.size() <= 8 && data.images[0] is string
        && data.description is string && data.description.size() >= 5 && data.description.size() <= 2000
        && (!('specs' in data) || data.specs is map)
        && data.stock is number && data.stock >= 0 && data.stock <= 100000
        && data.rating is number && data.rating >= 0 && data.rating <= 5
        && (!('reviewCount' in data) || (data.reviewCount is number && data.reviewCount >= 0))
        && data.featured is bool
        && (!('has3DPreview' in data) || data.has3DPreview is bool)
        && (!('shoePalette' in data) || data.shoePalette is map)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAddress(addr) {
      return addr is map
        && addr.keys().hasAll(['line1', 'city', 'state', 'postalCode', 'country'])
        && addr.keys().hasOnly(['line1', 'line2', 'city', 'state', 'postalCode', 'country'])
        && addr.line1 is string && addr.line1.size() >= 3 && addr.line1.size() <= 200
        && (!('line2' in addr) || (addr.line2 is string && addr.line2.size() <= 200))
        && addr.city is string && addr.city.size() >= 2 && addr.city.size() <= 80
        && addr.state is string && addr.state.size() >= 2 && addr.state.size() <= 80
        && addr.postalCode is string && addr.postalCode.size() >= 4 && addr.postalCode.size() <= 16
        && addr.country is string && addr.country.size() >= 2 && addr.country.size() <= 80;
    }

    function isValidOrder(data) {
      return data.keys().hasAll([
          'id', 'userId', 'customerName', 'customerEmail', 'customerPhone',
          'deliveryAddress', 'items', 'subtotalInr', 'discountInr', 'shippingInr',
          'totalInr', 'paymentMethod', 'paymentStatus', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'userId', 'customerName', 'customerEmail', 'customerPhone',
          'deliveryAddress', 'items', 'subtotalInr', 'discountInr', 'shippingInr',
          'totalInr', 'paymentMethod', 'paymentStatus', 'razorpayOrderId',
          'razorpayPaymentId', 'status', 'trackingCode', 'notes', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.userId)
        && data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 100
        && data.customerEmail is string && data.customerEmail.size() >= 3 && data.customerEmail.size() <= 160
        && data.customerPhone is string && data.customerPhone.size() >= 7 && data.customerPhone.size() <= 24
        && isValidAddress(data.deliveryAddress)
        && data.items is list && data.items.size() >= 1 && data.items.size() <= 30
        && data.subtotalInr is number && data.subtotalInr >= 0
        && data.discountInr is number && data.discountInr >= 0
        && data.shippingInr is number && data.shippingInr >= 0
        && data.totalInr is number && data.totalInr > 0
        && data.paymentMethod in ['COD', 'RAZORPAY']
        && data.paymentStatus in ['PENDING', 'PAID', 'COD_DUE', 'FAILED']
        && (data.paymentMethod == 'COD' ? data.paymentStatus == 'COD_DUE' : data.paymentStatus in ['PENDING', 'PAID', 'FAILED'])
        && (!('razorpayOrderId' in data) || (data.razorpayOrderId is string && data.razorpayOrderId.size() <= 128))
        && (!('razorpayPaymentId' in data) || (data.razorpayPaymentId is string && data.razorpayPaymentId.size() <= 128))
        && data.status in ['PLACED', 'CONFIRMED', 'SHIPPED', 'DELIVERED', 'CANCELLED']
        && (!('trackingCode' in data) || (data.trackingCode is string && data.trackingCode.size() <= 64))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCart(data) {
      return data.keys().hasAll(['userId', 'items', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'items', 'updatedAt'])
        && isValidId(data.userId)
        && data.items is list && data.items.size() <= 50
        && data.updatedAt is timestamp;
    }

    function isValidWishlist(data) {
      return data.keys().hasAll(['userId', 'productIds', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'productIds', 'updatedAt'])
        && isValidId(data.userId)
        && data.productIds is list && data.productIds.size() <= 100
        && data.updatedAt is timestamp;
    }

    function isValidStoreSettings(data) {
      return data.keys().hasAll(['brandName', 'tagline', 'accentColor', 'contactEmail', 'whatsappNumber', 'freeShippingThresholdInr', 'updatedAt'])
        && data.keys().hasOnly(['brandName', 'tagline', 'accentColor', 'contactEmail', 'contactPhone', 'whatsappNumber', 'heroTitle', 'heroSubtitle', 'freeShippingThresholdInr', 'updatedAt'])
        && data.brandName is string && data.brandName.size() >= 1 && data.brandName.size() <= 60
        && data.tagline is string && data.tagline.size() >= 1 && data.tagline.size() <= 120
        && data.accentColor is string && data.accentColor.size() >= 4 && data.accentColor.size() <= 20
        && data.contactEmail is string && data.contactEmail.size() >= 3 && data.contactEmail.size() <= 160
        && (!('contactPhone' in data) || (data.contactPhone is string && data.contactPhone.size() <= 24))
        && data.whatsappNumber is string && data.whatsappNumber.size() >= 5 && data.whatsappNumber.size() <= 24
        && (!('heroTitle' in data) || (data.heroTitle is string && data.heroTitle.size() <= 140))
        && (!('heroSubtitle' in data) || (data.heroSubtitle is string && data.heroSubtitle.size() <= 300))
        && data.freeShippingThresholdInr is number && data.freeShippingThresholdInr >= 0
        && data.updatedAt is timestamp;
    }

    function isValidContactMessage(data) {
      return data.keys().hasAll(['id', 'name', 'email', 'subject', 'message', 'createdAt'])
        && data.keys().hasOnly(['id', 'name', 'email', 'subject', 'message', 'userId', 'createdAt'])
        && isValidId(data.id)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.subject is string && data.subject.size() >= 2 && data.subject.size() <= 140
        && data.message is string && data.message.size() >= 5 && data.message.size() <= 2000
        && (!('userId' in data) || (data.userId is string && data.userId.size() <= 128))
        && data.createdAt is timestamp;
    }

    function isValidNewsletterSubscriber(data) {
      return data.keys().hasAll(['id', 'email', 'createdAt'])
        && data.keys().hasOnly(['id', 'email', 'createdAt'])
        && isValidId(data.id)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.createdAt is timestamp;
    }

    function isValidAdminMember(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'role', 'createdAt'])
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.role == 'admin'
        && data.createdAt is timestamp;
    }

    // --- Collection Rules ---
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdminEmail();
      allow create: if isVerified() && isValidId(userId) && isOwner(userId)
        && isValidUser(incoming())
        && incoming().uid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(userId) && isValidUser(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (isAdmin() || (
          isOwner(userId)
          && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'phone', 'photoURL', 'defaultAddress', 'updatedAt'])
        ));
      allow delete: if isValidId(userId) && isAdmin();
    }

    match /categories/{categoryId} {
      allow get: if isValidId(categoryId);
      allow list: if true;
      allow create: if isValidId(categoryId) && isAdmin() && isValidCategory(incoming());
      allow update: if isValidId(categoryId) && isAdmin() && isValidCategory(incoming()) && incoming().id == existing().id;
      allow delete: if isValidId(categoryId) && isAdmin();
    }

    match /products/{productId} {
      allow get: if isValidId(productId);
      allow list: if true;
      allow create: if isValidId(productId) && isAdmin()
        && isValidProduct(incoming())
        && incoming().id == productId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(productId) && isAdmin()
        && isValidProduct(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(productId) && isAdmin();
    }

    match /orders/{orderId} {
      allow get: if isValidId(orderId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdminEmail());
      allow create: if isVerified() && isValidId(orderId)
        && isValidOrder(incoming())
        && incoming().id == orderId
        && incoming().userId == request.auth.uid
        && incoming().status == 'PLACED'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(orderId)
        && isValidOrder(incoming())
        && incoming().id == existing().id
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            existing().userId == request.auth.uid
            && existing().status == 'PLACED'
            && incoming().status == 'CANCELLED'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );
      allow delete: if isValidId(orderId) && isAdmin();
    }

    match /carts/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isVerified() && isValidId(userId) && isOwner(userId)
        && isValidCart(incoming())
        && incoming().userId == request.auth.uid
        && incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(userId) && isOwner(userId)
        && isValidCart(incoming())
        && incoming().userId == existing().userId
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['items', 'updatedAt']);
      allow delete: if isValidId(userId) && isOwner(userId);
    }

    match /wishlists/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isVerified() && isValidId(userId) && isOwner(userId)
        && isValidWishlist(incoming())
        && incoming().userId == request.auth.uid
        && incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(userId) && isOwner(userId)
        && isValidWishlist(incoming())
        && incoming().userId == existing().userId
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['productIds', 'updatedAt']);
      allow delete: if isValidId(userId) && isOwner(userId);
    }

    match /storeSettings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if isAdminEmail();
      allow create: if isValidId(settingId) && isAdmin()
        && isValidStoreSettings(incoming())
        && incoming().updatedAt == request.time;
      allow update: if isValidId(settingId) && isAdmin()
        && isValidStoreSettings(incoming())
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(settingId) && isAdmin();
    }

    match /contactMessages/{messageId} {
      allow get: if isValidId(messageId) && isAdmin();
      allow list: if isAdminEmail();
      allow create: if isValidId(messageId)
        && isValidContactMessage(incoming())
        && incoming().id == messageId
        && incoming().createdAt == request.time
        && (!('userId' in incoming()) || (isSignedIn() && incoming().userId == request.auth.uid));
      allow update, delete: if isValidId(messageId) && isAdmin();
    }

    match /newsletterSubscribers/{subscriberId} {
      allow get: if isValidId(subscriberId) && isAdmin();
      allow list: if isAdminEmail();
      allow create: if isValidId(subscriberId)
        && isValidNewsletterSubscriber(incoming())
        && incoming().id == subscriberId
        && incoming().createdAt == request.time;
      allow update, delete: if isValidId(subscriberId) && isAdmin();
    }

    match /admins/{uid} {
      allow get: if isValidId(uid) && (isOwner(uid) || isAdmin());
      allow list: if isAdminEmail();
      allow create, update: if isValidId(uid) && isAdmin() && isValidAdminMember(incoming());
      allow delete: if isValidId(uid) && isAdmin();
    }
  }
}
